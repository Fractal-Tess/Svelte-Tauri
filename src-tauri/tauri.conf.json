{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PageLens",
  "version": "0.1.0",
  "identifier": "com.pagelens.app",
  "build": {
    "beforeDevCommand": "bun run svelte:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run svelte:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PageLens",
        "width": 900,
        "height": 600,
        "fullscreen": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
